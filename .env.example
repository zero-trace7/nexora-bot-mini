# ─── ZERO TRACE Configuration ─────────────────────────────────────────────────

# Fallback WhatsApp number (with country code, no + or spaces) used by .vv only
# when the bot's own linked identity can't be resolved.
# Example: 2348012345678
OWNER_NUMBER=your_number_here

# Bot display name
BOT_NAME=ZERO TRACE

# Command prefix
PREFIX=.

# Port for the status web server (Render sets this automatically — leave unset on Render)
PORT=3000

# Base directory that holds one auth sub-directory per user session.
# NOTE: on Render Free this is ephemeral (wiped on restart). Use a paid disk or
# a DB-backed store to persist sessions across restarts.
SESSIONS_DIR=./sessions

# ─── Optional API Keys (for better results) ───────────────────────────────────

# Unsplash API key for image search (get free key at unsplash.com/developers)
UNSPLASH_KEY=YOUR_UNSPLASH_KEY_HERE

# Giphy API key for GIF search (get free key at developers.giphy.com)
GIPHY_KEY=YOUR_GIPHY_KEY_HERE
